# Database Configuration
# Used by docker-compose.yaml and Spring Boot application
POSTGRES_DB=heartandfear
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Configuration
# IMPORTANT: Generate a secure secret for production using: openssl rand -base64 32
# This secret is used to sign JWT tokens - keep it secret and never commit to version control
JWT_SECRET=your-secure-256-bit-secret-here-change-in-production

# JWT Cookie Security (optional, defaults shown)
# Set to true in production to ensure cookies are only sent over HTTPS
# JWT_COOKIE_SECURE=false  # Set via application-prod.yaml instead

# Application Configuration (optional)
# Uncomment to override defaults from application.yaml

# Security settings
# APPLICATION_SECURITY_MAX_FAILED_ATTEMPTS=5
# APPLICATION_SECURITY_LOCKOUT_DURATION_MINUTES=30
# APPLICATION_SECURITY_FAILED_ATTEMPT_WINDOW_MINUTES=15

# Password requirements
# APPLICATION_PASSWORD_MIN_LENGTH=8
# APPLICATION_PASSWORD_REQUIRE_UPPERCASE=true
# APPLICATION_PASSWORD_REQUIRE_LOWERCASE=true
# APPLICATION_PASSWORD_REQUIRE_DIGIT=true
# APPLICATION_PASSWORD_REQUIRE_SPECIAL=true

# User defaults
# APPLICATION_USER_DEFAULT_AVATAR_URL=https://api.dicebear.com/7.x/avatars/svg?seed=default
# APPLICATION_USER_DEFAULT_TIMEZONE=UTC
